{
	"name": "@earendil-works/pi-coding-agent",
	"private": true,
	"version": "0.87.1",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"pi": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "file:../agent",
		"@earendil-works/pi-ai": "file:../ai",
		"@earendil-works/pi-tui": "file:../tui",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.27",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"typescript": "6.0.3",
		"vitest": "4.1.9"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	}
}
