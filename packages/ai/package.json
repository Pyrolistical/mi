{
	"name": "@earendil-works/pi-ai",
	"private": true,
	"version": "0.87.1",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./src/index.ts",
	"sideEffects": [
		"./dist/compat.js",
		"./dist/images.js",
		"./dist/providers/images/register-builtins.js"
	],
	"exports": {
		".": "./src/index.ts",
		"./compat": "./src/compat.ts",
		"./providers/*": "./src/providers/*.ts",
		"./api/*": "./src/api/*.ts",
		"./utils/*": "./src/utils/*.ts"
	},
	"dependencies": {
		"typebox": "1.3.27"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"engines": {
		"bun": ">=1.4.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0"
	}
}
